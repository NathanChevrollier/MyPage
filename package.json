{
  "name": "mypage",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "status"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w status",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.3"
  }
}
